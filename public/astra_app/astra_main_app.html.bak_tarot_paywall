       ======================================================== */
    let audioCtx = null, osc1 = null, osc2 = null, gainNode = null, isAudioPlaying = false;
    let currentFrequency = 432;

    function setHealingFrequency(freq, chip) {
      document.querySelectorAll('.freq-selector-chip').forEach(c => c.classList.remove('active'));
      if (chip) chip.classList.add('active');
      currentFrequency = freq;
      if (isAudioPlaying && osc1) {
        osc1.frequency.setValueAtTime(freq, audioCtx.currentTime);
        osc2.frequency.setValueAtTime(freq * 1.5, audioCtx.currentTime);
      }
    }

    function toggleTone() {
      const btn = document.getElementById('audio-toggle-btn');
      const label = document.getElementById('audio-btn-label');

      if (!isAudioPlaying) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        osc1 = audioCtx.createOscillator();
        osc2 = audioCtx.createOscillator();
        gainNode = audioCtx.createGain();

        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(currentFrequency, audioCtx.currentTime);

        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(currentFrequency * 1.5, audioCtx.currentTime);

        gainNode.gain.setValueAtTime(0, audioCtx.currentTime);
        gainNode.gain.linearRampToValueAtTime(0.08, audioCtx.currentTime + 1.2);

        osc1.connect(gainNode);
        osc2.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        osc1.start();
        osc2.start();

        isAudioPlaying = true;
        if (btn) btn.style.background = 'var(--moonly-purple)';
        if (label) label.innerText = `Играет ${currentFrequency} Гц • Нажмите для остановки`;
      } else {
        if (gainNode && audioCtx) {
          gainNode.gain.linearRampToValueAtTime(0.001, audioCtx.currentTime + 0.6);
          setTimeout(() => {
            if (osc1) osc1.stop();
            if (osc2) osc2.stop();
            if (audioCtx) audioCtx.close();
            isAudioPlaying = false;
            if (btn) btn.style.background = 'rgba(255,255,255,0.1)';
            if (label) label.innerText = `Слушать ${currentFrequency} Гц (Гармония)`;
          }, 600);
        }
      }
    }

