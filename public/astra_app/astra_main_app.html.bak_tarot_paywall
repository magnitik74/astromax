<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>АСТРА • В ритме Вселенной (Moonly Engine Clean-Room)</title>
  <style>
    /* ========================================================
       1. ДИЗАЙН-СИСТЕМА И ТОКЕНЫ MOONLY (com.moonly.android)
       ======================================================== */
    :root {
      --moonly-bg: #121316;
      --moonly-card: #1b1d21;
      --moonly-card-highlight: #24272e;
      --moonly-card-elevated: #282b34;
      --moonly-purple: #7048E8;
      --moonly-purple-light: #8A63FF;
      --moonly-purple-glow: rgba(112, 72, 232, 0.45);
      --moonly-text-primary: #FFFFFF;
      --moonly-text-secondary: rgba(255, 255, 255, 0.65);
      --moonly-text-muted: #5a595e;
      --moonly-text-sub: #acacac;
      --moonly-gold: #E5A93C;
      --moonly-gold-glow: rgba(229, 169, 60, 0.4);
      --moonly-green: #34C759;
      --font-stack: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
      font-family: var(--font-stack);
    }

    body {
      background: #08080a;
      color: var(--moonly-text-primary);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
    }

    /* Мобильный экран iPhone */
    .iphone-shell {
      position: relative;
      width: 100%;
      max-width: 428px;
      height: 100vh;
      max-height: 926px;
      background: var(--moonly-bg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 0 100px rgba(0, 0, 0, 0.95);
    }

    @media (min-width: 460px) {
      .iphone-shell {
        height: 880px;
        border-radius: 48px;
        border: 1px solid rgba(255, 255, 255, 0.12);
      }
    }

    /* Верхний статус-бар iOS */
    .ios-status-bar {
      height: 44px;
      padding: 0 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      font-weight: 600;
      color: var(--moonly-text-primary);
      z-index: 50;
      flex-shrink: 0;
    }

    .ios-icons {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
    }

    /* Контейнер экранов (ViewPager) */
    .screen-container {
      position: relative;
      flex: 1;
      width: 100%;
      height: calc(100% - 44px);
      overflow: hidden;
    }

    .screen-view {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      padding: 4px 16px 94px;
      display: none;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .screen-view::-webkit-scrollbar {
      display: none;
    }

    .screen-view.active {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    /* ========================================================
       2. ЭКРАН 1: КАЛЕНДАРЬ (fragment_bottom_calendar_v2.xml)
       ======================================================== */
    .calendar-header-row {
      display: flex;
      gap: 8px;
      margin-top: 8px;
      width: 100%;
      height: 84px;
    }

    .days-scroll-card {
      flex: 1;
      background: #18181D;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      display: flex;
      align-items: center;
      overflow-x: auto;
      padding: 6px 6px;
      gap: 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      cursor: grab;
      user-select: none;
    }

    .days-scroll-card:active {
      cursor: grabbing;
    }

    .days-scroll-card::-webkit-scrollbar {
      display: none;
    }

    .day-scroll-item {
      flex-shrink: 0;
      width: 48px;
      height: 70px;
      border-radius: 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 6px 0;
      cursor: pointer;
      transition: background 0.18s ease, transform 0.12s ease;
      background: transparent;
      user-select: none;
    }

    .day-scroll-item:active {
      transform: scale(0.96);
    }

    .day-scroll-item.selected {
      background: #25252C;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .day-scroll-weekday {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      color: #8E8E93;
      letter-spacing: 0.4px;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 13px;
    }

    .day-scroll-item.selected .day-scroll-weekday {
      color: #F7B64D;
      font-weight: 700;
    }

    .day-scroll-moon {
      width: 26px;
      height: 26px;
      object-fit: contain;
      filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5));
      pointer-events: none;
    }

    .day-scroll-num {
      font-size: 13px;
      font-weight: 600;
      color: #8E8E93;
      line-height: 1;
    }

    .day-scroll-item.selected .day-scroll-num,
    .day-scroll-item.is-today .day-scroll-num {
      color: #FFFFFF;
      font-weight: 700;
    }

    .calendar-full-view-btn {
      width: 56px;
      height: 84px;
      background: #18181D;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
      flex-shrink: 0;
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .calendar-full-view-btn:active {
      transform: scale(0.96);
      background: #22222A;
    }

    .calendar-full-view-icon {
      width: 20px;
      height: 20px;
      object-fit: contain;
      opacity: 0.9;
    }

    .calendar-full-view-month {
      font-size: 11px;
      font-weight: 700;
      color: #8E8E93;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    /* Card 2: Lunar Calendar Styling */
    .calendar-card-lunar {
      min-height: 230px;
      background: linear-gradient(135deg, #1A1D28 0%, #12131A 100%);
      border: 1px solid rgba(255, 255, 255, 0.06);
      margin-top: 14px;
    }

    .calendar-lunar-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 85% 75%, rgba(60, 90, 160, 0.25) 0%, transparent 60%);
      pointer-events: none;
    }

    .calendar-lunar-transit-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      color: #A0A5B5;
      margin-top: 14px;
      letter-spacing: 0.3px;
    }

    .calendar-lunar-dot {
      color: #606575;
      font-size: 10px;
    }

    .calendar-lunar-insight-text {
      font-size: 18px;
      line-height: 1.35;
      font-weight: 600;
      color: #FFFFFF;
      margin-top: 10px;
      padding-right: 20px;
    }

    .dreamer-quick-banner {
      background: linear-gradient(135deg, rgba(35, 30, 48, 0.9) 0%, rgba(20, 20, 30, 0.9) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 14px;
      cursor: pointer;
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .dreamer-quick-banner:active {
      transform: scale(0.98);
      background: rgba(45, 38, 60, 0.9);
    }

    .dreamer-quick-icon {
      width: 28px;
      height: 28px;
      object-fit: contain;
    }

    .dreamer-quick-text {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .dreamer-quick-sub {
      font-size: 10px;
      font-weight: 700;
      color: #A0A0B0;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .dreamer-quick-title {
      font-size: 14px;
      font-weight: 700;
      color: #FFF;
      margin-top: 2px;
    }

    /* view_calendar_v2_event_large.xml */
    .calendar-event-large-card {
      position: relative;
      background: var(--moonly-card);
      border-radius: 32px;
      overflow: hidden;
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
      cursor: pointer;
      min-height: 280px;
    }

    .calendar-event-bg-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.6;
      z-index: 1;
      transition: opacity 0.3s ease;
    }

    .calendar-event-gradient-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, rgba(27,29,33,0.3) 0%, rgba(27,29,33,0.85) 65%, #1b1d21 100%);
      z-index: 2;
    }

    .calendar-event-content {
      position: relative;
      z-index: 3;
      padding: 22px;
      display: flex;
      flex-direction: column;
    }

    .calendar-event-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 48px;
    }

    .calendar-event-header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .calendar-event-header-icon {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }

    .calendar-event-top-tag {
      font-size: 11px;
      font-weight: 700;
      color: var(--moonly-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .calendar-event-day-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--moonly-text-primary);
      margin-top: 2px;
    }

    .calendar-event-arrow {
      width: 20px;
      height: 20px;
      object-fit: contain;
      opacity: 0.7;
    }

    .calendar-event-focus-tag {
      font-size: 11px;
      font-weight: 700;
      color: var(--moonly-text-primary);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-top: 18px;
    }

    .calendar-event-main-text {
      font-size: 19px;
      line-height: 1.35;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.95);
      margin-top: 8px;
      padding-right: 48px;
    }

    .calendar-event-bottom-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 26px;
    }

    .calendar-event-status-block {
      display: flex;
      flex-direction: column;
    }

    .calendar-event-status-tag {
      font-size: 10px;
      font-weight: 700;
      color: var(--moonly-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .calendar-event-status-val {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 4px;
      font-size: 17px;
      font-weight: 700;
      color: var(--moonly-text-primary);
    }

    .calendar-event-badge-icon {
      width: 18px;
      height: 18px;
      object-fit: contain;
    }

    .calendar-event-3d-moon-corner {
      width: 64px;
      height: 64px;
      object-fit: contain;
      filter: drop-shadow(0 6px 14px rgba(0,0,0,0.6));
    }

    /* view_calendar_v2_transit_card.xml */
    .calendar-transit-card {
      position: relative;
      background: var(--moonly-card);
      border-radius: 28px;
      padding: 20px;
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      cursor: pointer;
    }

    .calendar-transit-date {
      font-size: 11px;
      font-weight: 700;
      color: var(--moonly-text-sub);
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .calendar-transit-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--moonly-text-primary);
      margin-top: 4px;
    }

    .calendar-transit-stats-row {
      display: flex;
      margin-top: 14px;
      gap: 20px;
    }

    .calendar-transit-stat-col {
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .calendar-transit-stat-label {
      font-size: 10px;
      font-weight: 600;
      color: var(--moonly-text-secondary);
      text-transform: uppercase;
    }

    .calendar-transit-stat-value {
      font-size: 16px;
      font-weight: 700;
      color: var(--moonly-text-primary);
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .calendar-transit-zodiac-icon {
      width: 16px;
      height: 16px;
      object-fit: contain;
    }

    .lifestyle-section-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--moonly-text-sub);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin: 24px 0 10px 4px;
    }

    .lifestyle-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .lifestyle-badge-card {
      background: var(--moonly-card);
      border-radius: 20px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: transform 0.15s ease;
    }

    .lifestyle-badge-card:active {
      transform: scale(0.97);
    }

    .lifestyle-badge-icon {
      width: 32px;
      height: 32px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .lifestyle-badge-info {
      display: flex;
      flex-direction: column;
    }

    .lifestyle-badge-name {
      font-size: 13px;
      font-weight: 700;
      color: var(--moonly-text-primary);
    }

    .lifestyle-badge-desc {
      font-size: 11px;
      color: var(--moonly-text-sub);
      margin-top: 2px;
    }

    /* ========================================================
       3. ЭКРАН 2: ПРАКТИКИ (ТАРО / РУНЫ / МУДРОСТЬ / АФФИРМАЦИИ)
       ======================================================== */
    .practices-header-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 8px 0 12px;
      scrollbar-width: none;
    }

    .practices-header-tabs::-webkit-scrollbar {
      display: none;
    }

    .practice-main-tab-pill {
      height: 40px;
      padding: 0 18px;
      border-radius: 20px;
      background: var(--moonly-card);
      color: var(--moonly-text-primary);
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
    }

    .practice-main-tab-pill.active {
      background: #FFFFFF;
      color: #000000;
    }

    /* Подвкладки Moonly: Расклад vs Все 78 карт */
    .deck-subtabs-bar {
      display: flex;
      justify-content: center;
      margin: 4px 0 16px;
    }

    .deck-subtabs-pill {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      padding: 3px;
      display: flex;
      gap: 4px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .deck-subtab-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 15px;
      font-size: 12px;
      font-weight: 600;
      color: var(--moonly-text-secondary);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .deck-subtab-btn.active {
      background: rgba(255, 255, 255, 0.2);
      color: #FFFFFF;
    }

    .deck-subtab-btn img {
      width: 16px;
      height: 16px;
      object-fit: contain;
    }

    /* РАСКЛАД ДНЯ (fragment_practice_spread_one_card.xml) */
    .spread-one-card-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
    }

    .spread-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--moonly-text-primary);
      margin-top: 8px;
    }

    .spread-subtitle {
      font-size: 14px;
      color: var(--moonly-text-secondary);
      margin-top: 6px;
      max-width: 280px;
    }

    /* Слот карты (ic_tarot_spread_slot_active.png) */
    .spread-slot-wrapper {
      position: relative;
      width: 140px;
      height: 216px;
      margin-top: 24px;
      perspective: 1000px;
    }

    .spread-slot-frame {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border-radius: 16px;
      border: 2px dashed rgba(138, 99, 255, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(112, 72, 232, 0.05);
      box-shadow: 0 0 25px rgba(112, 72, 232, 0.15);
      transition: all 0.3s ease;
    }

    .spread-slot-frame.glow {
      border-color: var(--moonly-gold);
      box-shadow: 0 0 35px rgba(229, 169, 60, 0.45);
    }

    .spread-slot-card {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border-radius: 16px;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      cursor: pointer;
    }

    .spread-slot-card.flipped {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 16px;
      backface-visibility: hidden;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
    }

    .card-face.back {
      background: #1B1A24;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-face.back img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-face.front {
      transform: rotateY(180deg);
      background: #000;
    }

    .card-face.front img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .spread-prompt-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 18px;
      transition: opacity 0.3s ease;
    }

    .spread-prompt-arrow {
      width: 16px;
      height: 16px;
      object-fit: contain;
      animation: bounceArrow 1.5s infinite ease-in-out;
    }

    @keyframes bounceArrow {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(6px); }
    }

    .spread-prompt-text {
      font-size: 14px;
      font-weight: 700;
      color: var(--moonly-text-primary);
      margin-top: 6px;
    }

    .spread-result-details {
      display: none;
      flex-direction: column;
      align-items: center;
      margin-top: 18px;
      width: 100%;
      animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .spread-card-name {
      font-size: 18px;
      font-weight: 800;
      color: var(--moonly-text-primary);
    }

    .spread-card-archetype {
      font-size: 12px;
      font-weight: 700;
      color: var(--moonly-gold);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-top: 4px;
    }

    .spread-card-reading {
      font-size: 14px;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.9);
      background: var(--moonly-card);
      border-radius: 20px;
      padding: 16px;
      margin-top: 12px;
      text-align: left;
    }

    .spread-actions-row {
      display: flex;
      gap: 12px;
      margin-top: 16px;
      width: 100%;
    }

    .spread-reset-btn {
      width: 48px;
      height: 48px;
      border-radius: 24px;
      background: var(--moonly-card);
      border: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
    }

    .spread-reset-btn img {
      width: 20px;
      height: 20px;
      object-fit: contain;
    }

    .spread-full-reading-btn {
      flex: 1;
      height: 48px;
      border-radius: 24px;
      background: linear-gradient(135deg, var(--moonly-purple), var(--moonly-purple-light));
      border: none;
      color: #FFF;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(112, 72, 232, 0.4);
    }

    
    /* СТИКИ-ХЕДЕР КАЛЕНДАРЯ (Moonly Sticky Week Strip) */
    .calendar-sticky-header {
      position: sticky;
      top: 0;
      z-index: 95;
      background: rgba(18, 17, 24, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 6px 0 10px;
      margin-bottom: 2px;
    }

    /* БЫСТРЫЕ КНОПКИ (Quick Action Pills: Натальная карта & Таро) */
    .calendar-quick-actions-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 10px;
      margin-bottom: 4px;
    }

    .calendar-quick-pill {
