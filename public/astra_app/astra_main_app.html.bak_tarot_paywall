      setTimeout(() => {
        const sel = track.querySelector(`.day-scroll-item[data-date-key="${currentSelectedDateKey}"]`);
        if (sel) {
          const scrollPos = sel.offsetLeft - (track.clientWidth / 2) + (sel.clientWidth / 2);
