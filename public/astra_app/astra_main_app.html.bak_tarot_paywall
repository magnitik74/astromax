    function sendChatMessage() {
      const input = document.getElementById('chat-input-field');
      const text = input.value.trim();
      if (!text) return;
      input.value = '';

      const container = document.getElementById('chat-messages');
      const userBubble = document.createElement('div');
      userBubble.className = 'chat-bubble-user';
      userBubble.innerText = text;
      container.appendChild(userBubble);
      container.scrollTop = container.scrollHeight;

      setTimeout(() => {
        const astroBubble = document.createElement('div');
        astroBubble.className = 'chat-bubble-astro';
        astroBubble.innerText = getAstrologicalAIResponse(text);
        container.appendChild(astroBubble);
        container.scrollTop = container.scrollHeight;
      }, 700);
    }

    function sendQuickMessage(text) {
      document.getElementById('chat-input-field').value = text;
