    function switchTab(screenId) {
      document.querySelectorAll('.screen-view').forEach(el => el.classList.remove('active'));
      document.getElementById(screenId).classList.add('active');

      const tabs = document.querySelectorAll('.moonly-tab-item');
      tabs.forEach(t => t.classList.remove('active'));

      const idMap = {
        'screen-calendar': 0,
        'screen-practices': 1,
        'screen-healing': 2,
        'screen-chat': 3,
        'screen-you': 4
      };
      if (tabs[idMap[screenId]]) {
        tabs[idMap[screenId]].classList.add('active');
      }
    }

